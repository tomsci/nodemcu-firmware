export BUILD=~/dev/esp32/build
# export DEST=/media/sf_turc/rom
export DEST=/media/sf_statuspanel/esp32

# That --match arg can't be the best way to do it, but hey it works thanks Mr StackOverflow
export VER=`git describe --match=NeVeRmAtCh --always --abbrev=8 --dirty`

# Needed so that the potentially-updated BUILD_DATE is picked up
touch components/lua/lua.c

INIT_SCRIPT="\"(node.flashindex(\\\"init\\\") or (function() print(\\\"No LFS!\\\") end))()\""

make MORE_CFLAGS="-DLUA_NUMBER_INTEGRAL -DBUILD_DATE='\"'$VER'\"' -DLUA_INIT_STRING='$INIT_SCRIPT'" V=99
cp $BUILD/../sdkconfig $DEST
cp $BUILD/bootloader/bootloader.bin $DEST
cp $BUILD/NodeMCU.bin $DEST
cp $BUILD/NodeMCU.elf $DEST
cp $BUILD/partitions.bin $DEST/partitions.bin
